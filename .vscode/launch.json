{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CodeMRI: Demo extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/extension",
        "${workspaceFolder}/examples/MemMunkDB"
      ],
      "outFiles": [
        "${workspaceFolder}/apps/extension/dist/**/*.js"
      ],
      "preLaunchTask": "build extension"
    },
    {
      "name": "CodeMRI: Stoich create demo",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/extension",
        "${workspaceFolder}/examples/Stoich"
      ],
      "outFiles": [
        "${workspaceFolder}/apps/extension/dist/**/*.js"
      ],
      "preLaunchTask": "build extension"
    }
  ]
}
